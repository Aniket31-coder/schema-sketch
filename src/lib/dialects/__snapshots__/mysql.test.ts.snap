// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mysql emitter > emits FKs correctly 1`] = `
"CREATE TABLE customer (
  id INT NOT NULL,
  CONSTRAINT pk_customer PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE \`order\` (
  id          INT NOT NULL,
  customer_id INT NOT NULL,
  CONSTRAINT pk_order PRIMARY KEY (id)
) ENGINE=InnoDB;

ALTER TABLE \`order\`
  ADD CONSTRAINT fk_order_customer
  FOREIGN KEY (customer_id) REFERENCES customer (id);
"
`;

exports[`mysql emitter > emits a many-to-many relationship as a join table 1`] = `
"CREATE TABLE \`user\` (
  id INT NOT NULL,
  CONSTRAINT pk_user PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE role (
  id INT NOT NULL,
  CONSTRAINT pk_role PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE role_user (
  role_id INT NOT NULL,
  user_id INT NOT NULL,
  CONSTRAINT pk_role_user PRIMARY KEY (role_id, user_id)
) ENGINE=InnoDB;

ALTER TABLE role_user
  ADD CONSTRAINT fk_role_user_role
  FOREIGN KEY (role_id) REFERENCES role (id);

ALTER TABLE role_user
  ADD CONSTRAINT fk_role_user_user
  FOREIGN KEY (user_id) REFERENCES \`user\` (id);
"
`;

exports[`mysql emitter > emits a single entity with TINYINT for bool and CHAR(36) for uuid 1`] = `
"CREATE TABLE \`user\` (
  id        CHAR(36)     NOT NULL,
  email     VARCHAR(255) NOT NULL,
  is_active TINYINT(1)   NOT NULL,
  CONSTRAINT pk_user PRIMARY KEY (id),
  CONSTRAINT uk_user_email UNIQUE (email)
) ENGINE=InnoDB;
"
`;
